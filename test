import numpy as np

pieces = np.zeros((8,8), dtype=str)

for row in range(pieces.shape[0]):
    for col in range(pieces.shape[1]):
        if row in (0,1,2) and row%2 !=col%2:
            pieces[row][col] = 'b'
        elif row in (5,6,7) and row%2 != col%2:
            pieces[row][col] = 'w'


print(pieces)

